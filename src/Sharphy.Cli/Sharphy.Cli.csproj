<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sharphy.Server\Sharphy.Server.csproj" />
    <ProjectReference Include="..\Sharphy.Core\Sharphy.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>Sharphy.Cli</PackageId>
    <Description>Global CLI and MCP server executable bridge for Sharphy CLR Intelligence.</Description>
    <PackageTags>cli;tool;mcp;clr;diagnostics;decompiler;reverse-engineering</PackageTags>
    
    <!-- Pack as .NET Global Tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sharphy</ToolCommandName>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
