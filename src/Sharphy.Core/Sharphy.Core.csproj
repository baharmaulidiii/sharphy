<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Sharphy.Core</PackageId>
    <Description>Core diagnostics, decompiler, ECMA-335 metadata, and CIL mutation engines for Sharphy.</Description>
    <PackageTags>clr;diagnostics;decompiler;il;clrmd;cecil;roslyn;mcp</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ICSharpCode.Decompiler" Version="8.2.0.7535" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
