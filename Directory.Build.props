<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    
    <!-- Multi-targeting -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Version>1.0.3</Version>
    
    <!-- Package Metadata & Branding -->
    <Authors>Bahar Maulidi</Authors>
    <Company>Sharphy Contributors</Company>
    <Product>Sharphy</Product>
    <Description>CLR Intelligence &amp; Runtime Forensic Bridge for AI Coding Agents</Description>
    <RepositoryUrl>https://github.com/baharmaulidiii/sharphy</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <!-- NuGet Package Icon & Readme -->
    <PackageIcon>sharphy.png</PackageIcon>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\sharphy.png" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)assets\sharphy.png')" />
    <None Include="$(MSBuildThisFileDirectory)PACKAGE_README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)PACKAGE_README.md')" />
  </ItemGroup>
</Project>